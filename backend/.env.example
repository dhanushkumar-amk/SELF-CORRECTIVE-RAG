# ─── Self-Correcting RAG — Backend Environment Variables ─────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Pinecone Vector Database ─────────────────────────────────────────────────
# Required: Get your API key from https://app.pinecone.io (free tier)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=self-correcting-rag

# ── LLM Providers (Required for Phase 25+) ───────────────────────────────────
# At least ONE LLM provider key is needed in production.
# Google Gemini (https://ai.google.dev/)
GEMINI_API_KEY=your-gemini-api-key-here
# Groq (https://console.groq.com/) — fast inference alternative
GROQ_API_KEY=your-groq-api-key-here

# ── LangChain / LangSmith (Optional — Debugging & Tracing) ──────────────────
# LangSmith provides observability into LangGraph execution: traces, latency,
# token usage, and step-by-step debugging of the self-correction loop.
# Sign up at https://smith.langchain.com/ to get an API key.
#
# Set LANGCHAIN_TRACING_V2=true to enable tracing (requires LANGCHAIN_API_KEY).
# When disabled, the app works identically — tracing is purely observational.
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_TRACING_V2=false

# ── Application ──────────────────────────────────────────────────────────────
PROJECT_NAME=Self-Correcting RAG
VERSION=0.1.0
ENVIRONMENT=development

# ── Development Flags ────────────────────────────────────────────────────────
# Set to false to skip API key validation on startup (useful for early
# development phases before you have real API keys configured).
REQUIRE_API_KEYS=false
