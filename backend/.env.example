# ─── Self-Correcting RAG — Backend Environment Variables ─────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Production Note (Phase 50):
# In production, inject secrets directly via environment variables or a secrets manager
# (AWS Secrets Manager, GCP Secret Manager, Vault) rather than storing a .env file.

# ── Pinecone Vector Database (Required Now — Phase 3+) ────────────────────────
# High-performance serverless vector database used for dense vector indexing & hybrid retrieval.
# Sign up (Free Starter Tier, no credit card required): https://app.pinecone.io/
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=self-correcting-rag

# ── LLM Providers (Required for Phase 25+ — Generation) ───────────────────────
# In Phase 25+, at least ONE provider key is required to power LLM generation.
# Google Gemini API key (Free Tier available): https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key-here
# Groq API key for low-latency Llama-3 inference (Free Tier available): https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here

# ── LangChain / LangSmith Tracing (Optional — Debugging) ──────────────────────
# Observability platform to trace graph state transitions, token usage, and latency.
# Sign up for a free key: https://smith.langchain.com/
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=self-correcting-rag
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Runtime & Server Configuration ────────────────────────────────────────────
# Options: development, staging, production, test
ENVIRONMENT=development
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
PROJECT_NAME=Self-Correcting RAG
VERSION=0.1.0

# ── Safety & CI Flags ─────────────────────────────────────────────────────────
# When true, the application fails fast on startup if required keys are missing or placeholders.
# Set to false to run the app offline or in early local dev without real keys.
REQUIRE_API_KEYS=false

# ── Document Storage & Ingestion (Phase 6+) ───────────────────────────────────
# Directory for storing uploaded raw PDF documents and json registry
UPLOAD_DIR=uploads
# Maximum allowed file upload size in megabytes (default: 20MB)
MAX_UPLOAD_SIZE_MB=20
